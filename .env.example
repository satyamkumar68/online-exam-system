# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_exam_system
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_long
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8081

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Proctoring Service
PROCTORING_SERVICE_URL=http://localhost:5000

# Application
APP_NAME=Online Examination System
APP_VERSION=1.0.0
ENVIRONMENT=development
