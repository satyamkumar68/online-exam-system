# Proctoring Service Environment Variables

# Flask Configuration
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Backend API
BACKEND_URL=http://localhost:8081/api

# Face Detection Settings
FACE_DETECTION_SCALE_FACTOR=1.1
FACE_DETECTION_MIN_NEIGHBORS=5
FACE_DETECTION_MIN_SIZE=30,30

# Absence Detection Settings
ABSENCE_THRESHOLD_COUNT=3
ABSENCE_RESET_TIMEOUT=60

# Logging
LOG_LEVEL=INFO

# Redis (for future use)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
